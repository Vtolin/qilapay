# Copy to .env and fill in. Never commit .env (see .gitignore).
# Fix F4: document every required variable; values stay local-only.

# Postgres (Neon / Vercel Postgres / Supabase). Get both URLs from your
# provider dashboard (Vercel: Storage -> DB -> .env.local tab).
# - DATABASE_URL: pooled connection (port 6543, ?sslmode=require / ?pgbouncer=true).
#   If your store was named DATABASE_URL, copy the value of
#   DATABASE_URL_PRISMA_DATABASE_URL (or DATABASE_URL_POSTGRES_URL) here.
# - DIRECT_URL: direct non-pooled connection (port 5432). Used by
#   `prisma migrate deploy` / `migrate diff` / seeds. Copy the
#   ..._NON_POOLING value here.
# Never use a `file:` URL anymore (SQLite is retired; provider is postgresql).
DATABASE_URL=postgresql://user:password@host:6543/db?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/db?sslmode=require

TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_EXPLORER_URL=https://explore.testnet.tempo.xyz
TEMPO_FAUCET_URL=https://tempo.xyz/developers/api/faucet

# Custodial/test keys. Testnet only. Rotate immediately if ever committed
# or bundled into a build artifact or download bundle.
TREASURY_PRIVATE_KEY=
WALLET_ENCRYPTION_KEY=
SESSION_SECRET=
PASSWORD_PEPPER=

# Demo backdoors (persona login, KYC simulation). Safe default: off in
# production — isDemoMode() force-returns false under NODE_ENV=production
# unless the explicit opt-in below is also set. Only enable the opt-in on a
# throwaway judging/demo deployment, never on anything holding real funds.
DEMO_MODE=false
QILA_DEMO_BACKDOORS=
