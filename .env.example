# Copy to .env and fill in. Never commit .env (see .gitignore).
# Fix F4: document every required variable; values stay local-only.

# SQLite file. Relative `file:` URLs resolve against the prisma/ directory
# (verified empirically), NOT the process cwd. For deploys, prefer an
# absolute path on a persistent volume, e.g. file:/data/qilapay.db
DATABASE_URL=file:../db/custom.db

TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_EXPLORER_URL=https://explore.testnet.tempo.xyz
TEMPO_FAUCET_URL=https://tempo.xyz/developers/api/faucet

# Custodial/test keys. Testnet only. Rotate immediately if ever committed
# or bundled into a build artifact or download bundle.
TREASURY_PRIVATE_KEY=
WALLET_ENCRYPTION_KEY=
SESSION_SECRET=
PASSWORD_PEPPER=

# Demo backdoors (persona login, KYC simulation). Must be false/absent in
# production — isDemoMode() force-returns false under NODE_ENV=production.
DEMO_MODE=false
