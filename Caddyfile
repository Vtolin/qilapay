:81 {
	# Audit H6: static upstream only. The previous XTransformPort query-driven
	# reverse_proxy let clients relay to any localhost port (SSRF/port-scan).
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
